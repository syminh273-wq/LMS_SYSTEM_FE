{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../packages/shared/src/*"],
      "@lms/types": ["../../packages/types/src/index.ts"],
      "@lms/api": ["../../packages/api/src/index.ts"],
      "@lms/hooks": ["../../packages/hooks/src/index.ts"],
      "@lms/ui": ["../../packages/ui/src/index.ts"],
      "@lms/ui/*": ["../../packages/ui/src/*"],
      "@lms/utils": ["../../packages/utils/src/index.ts"],
      "@lms/config": ["../../packages/config"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
