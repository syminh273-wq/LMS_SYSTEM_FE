{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/consumer-web": {
      "entry": ["src/app/**/{page,layout,route,loading,error,not-found,template,default}.{ts,tsx}", "src/middleware.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/space-web": {
      "entry": ["src/app/**/{page,layout,route,loading,error,not-found,template,default}.{ts,tsx}", "src/middleware.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
